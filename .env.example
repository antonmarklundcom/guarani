# Guaraní — environment template.
#
# Plan §4: a missing value here degrades gracefully and never blocks a build
# phase or a running job. Each var says what happens when it is absent.

# --- Database (required before any query runs) ---
# Hostinger MySQL. Format: mysql://user:password@host:3306/dbname
# Absent: any DB-touching command fails with a clear message. Nothing else breaks.
DATABASE_URL=

# --- Object storage (Cloudflare R2 or any S3-compatible bucket) ---
# Plan §1: provider output URLs are assumed to EXPIRE, so every completed
# generation job downloads its artifact into our own bucket immediately.
# Absent: storage logs one WARN, keeps the provider URL, and marks the artifact
# non-durable. Nothing blocks — but artifacts are at risk until this is wired.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Defaults to "auto", which is what R2 expects.
S3_REGION=auto
# Optional. Public base URL for reading objects back (e.g. a CDN domain).
# Absent: URLs are built from S3_ENDPOINT + S3_BUCKET.
S3_PUBLIC_BASE_URL=

# --- Higgsfield ---
# The production transport for HiggsfieldAdapter (src/providers/higgsfield.ts).
# NOTE: opus-2 re-checked and could NOT verify the HTTP wire format either —
# the docs host is refused by this environment's egress policy (403 on CONNECT),
# which is an organization policy denial, not a transient failure. No HTTP
# transport ships, because one written from memory would pass its own tests and
# fail on the first real call. See KNOWN-ISSUES #1.
# Absent (and it is): provider calls fail with a message naming this issue.
# Set GUARANI_TTS_PROVIDER=mock below to run the pipeline without a provider.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=

# --- Cost normalization (opus-2) ---
# USD per Higgsfield credit. Left blank on purpose: these credits come out of a
# monthly plan allowance that is already paid for, so the honest marginal rate
# is (monthly plan price in USD) / (monthly credit allowance) — a number only
# the account holder knows. A credit top-up price would describe a purchase
# that is not how these credits are bought and would overstate every video.
# Absent: no provider_rates row is written, generation_jobs.cost_usd stays NULL,
# and cost_raw_amount still records every credit — so setting this later
# re-prices the whole history. Applied by `npm run seed:voices`.
HIGGSFIELD_USD_PER_CREDIT=
# Optional label stored alongside the rate, e.g. "creator monthly".
HIGGSFIELD_PLAN_LABEL=

# --- Provider selection (opus-2) ---
# `mock` runs the entire pipeline — script, TTS, ffprobe measurement, storage,
# A/B harness — against canned fixtures for zero credits. The mock provider
# returns a real, playable WAV as a data URL, so durations are genuinely
# measured rather than faked. This is what the test suite uses.
# Absent or `higgsfield`: a Higgsfield transport must be registered first
# (see KNOWN-ISSUES #1) or provider calls fail with a clear message.
GUARANI_TTS_PROVIDER=

# --- Admin API gate (opus-2) ---
# Bearer token for POST /api/tts, which spends credits and produces publishable
# audio. Set: the route requires `Authorization: Bearer <token>`.
# Absent: the route serves unauthenticated OUTSIDE production (with a warning)
# and refuses with 503 in production — a metered endpoint is never left open on
# a deployed host. Real auth is sonnet-2/§2's job.
ADMIN_API_TOKEN=
