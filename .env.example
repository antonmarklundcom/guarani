# Guaraní — environment template.
#
# Plan §4: a missing value here degrades gracefully and never blocks a build
# phase or a running job. Each var says what happens when it is absent.

# --- Database (required before any query runs) ---
# Hostinger MySQL. Format: mysql://user:password@host:3306/dbname
# Absent: any DB-touching command fails with a clear message. Nothing else breaks.
DATABASE_URL=

# --- Object storage (Cloudflare R2 or any S3-compatible bucket) ---
# Plan §1: provider output URLs are assumed to EXPIRE, so every completed
# generation job downloads its artifact into our own bucket immediately.
# Absent: storage logs one WARN, keeps the provider URL, and marks the artifact
# non-durable. Nothing blocks — but artifacts are at risk until this is wired.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Defaults to "auto", which is what R2 expects.
S3_REGION=auto
# Optional. Public base URL for reading objects back (e.g. a CDN domain).
# Absent: URLs are built from S3_ENDPOINT + S3_BUCKET.
S3_PUBLIC_BASE_URL=

# --- Higgsfield ---
# The production transport for HiggsfieldAdapter (src/providers/higgsfield.ts).
# NOTE: the HTTP request/response shapes in HttpTransport were NOT verified
# against real API docs in opus-1 (the docs host is unreachable from the build
# environment) — confirm them in opus-2 before any production traffic.
# See KNOWN-ISSUES.md.
# Absent: the adapter cannot be constructed with an HTTP transport; the mock
# provider still works, so tests and local development are unaffected.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=
